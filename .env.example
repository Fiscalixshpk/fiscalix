# ============================================================
# FineX OS — Environment Variables
# ============================================================
# KOPJO KËtë FAJLL SI .env.local dhe plotëso vlerat
# cp .env.example .env.local
# ============================================================

# ── SUPABASE ───────────────────────────────────────────────
# Merri nga: supabase.com → Projekti yt → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── OPENAI (për AI OCR Scanner) ────────────────────────────
# Merre nga: platform.openai.com → API Keys → Create new
# Kosto: ~$0.001 për çdo skanim fature

OPENAI_API_KEY=sk-proj-...

# ── APP CONFIG ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FineX OS

# ── KONFIGURIMI I PLANEVE ──────────────────────────────────
BASIC_PRICE=19
PREMIUM_PRICE=39
ADVANCED_PRICE=79
PREMIUM_AI_SCAN_LIMIT=150
GRACE_PERIOD_DAYS=5

# ── ÇELËSI I ADMIN (opsional) ─────────────────────────────
ADMIN_EMAIL=admin@finex.com

# Email (Resend.com - free 3000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Cron secret (for recurring invoice auto-generation)  
CRON_SECRET=your-secret-key-here
CRON_SECRET=vendos_nje_string_te_gjate_ketu
